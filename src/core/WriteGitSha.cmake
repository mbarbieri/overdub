# Runs at build time (cmake -P): writes OUTPUT_FILE defining overdub::core::buildGitSha() from
# `git rev-parse` in SOURCE_DIR, plus "-dirty" when tracked files have uncommitted changes.
# Rewrites the file only when its content changed, so unchanged builds stay incremental.
# Falls back to "unknown" outside a git checkout.
execute_process(
    COMMAND git rev-parse --short=12 HEAD
    WORKING_DIRECTORY "${SOURCE_DIR}"
    OUTPUT_VARIABLE git_sha
    OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE git_result
    ERROR_QUIET)

if(NOT git_result EQUAL 0 OR git_sha STREQUAL "")
    set(git_sha "unknown")
else()
    execute_process(
        COMMAND git status --porcelain --untracked-files=no
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE git_changes
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET)
    if(NOT git_changes STREQUAL "")
        string(APPEND git_sha "-dirty")
    endif()
endif()

set(content "// Generated by src/core/WriteGitSha.cmake at build time. Do not edit.\nnamespace overdub::core\n{\nconst char* buildGitSha();\nconst char* buildGitSha() { return \"${git_sha}\"; }\n} // namespace overdub::core\n")

if(EXISTS "${OUTPUT_FILE}")
    file(READ "${OUTPUT_FILE}" existing)
else()
    set(existing "")
endif()

if(NOT existing STREQUAL content)
    file(WRITE "${OUTPUT_FILE}" "${content}")
endif()
